# Copy to .env and replace every placeholder. Do not commit .env.
# These values are examples. They are not secrets and they are not a live deployment.

# Postgres bootstrap superuser. Used only by the database image to create roles.
# The API and workers do not connect as this user.
POSTGRES_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password

# Owns the schema and runs Alembic. Not used for request handling.
SPENDPILOT_MIGRATOR_PASSWORD=replace-with-a-long-random-password

# Runtime role. Not a superuser, not a table owner, and not BYPASSRLS.
SPENDPILOT_APP_PASSWORD=replace-with-a-long-random-password

# Absolute URL of the same-site gateway. Verification and reset links use this
# value. They never use the request Host header.
PUBLIC_APP_URL=http://127.0.0.1:8080

# Comma-separated browser origins allowed to call the API directly.
# The public app origin is always included. Same-site gateway traffic does not need CORS.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://127.0.0.1:5173

# Set true behind HTTPS. Leave false only for this local HTTP gateway.
COOKIE_SECURE=false

# Server-side idle lock. Allowed range is 5 to 60 minutes. Default 15.
IDLE_LOCK_MINUTES=15

# smtp uses the SMTP_* settings below. capture writes to mail_outbox for tests
# and is not a mailbox. With smtp and an empty SMTP_HOST, password reset stays off.
EMAIL_DELIVERY=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# AES-GCM key ring. Format: keyId:base64,anotherId:base64
# Each key is 32 bytes. APP_ENCRYPTION_KEY_ID names the key used for new ciphertext.
# Generate locally. Do not put a real key in this example file.
APP_ENCRYPTION_KEYS=
APP_ENCRYPTION_KEY_ID=

# Hosts or IPs that may be private or loopback for a model connection test.
# Metadata addresses stay blocked even if listed here. Leave empty until an endpoint exists.
MODEL_ALLOWED_PRIVATE_HOSTS=

# configured uses only the endpoint saved in SpendPilot. fake is the deterministic CI provider.
# fake does not call the network and is not a fallback when a saved endpoint fails.
SPENDPILOT_PROVIDER=configured

# Optional live smoke test for an OpenAI-compatible endpoint you already run.
# Leave empty. Live tool-calling stays unverified until this is set. Do not point it at a hosted fallback.
# MODEL_SMOKE_URL=
# MODEL_SMOKE_MODEL=
# MODEL_SMOKE_API_KEY=

# Compose sets TRUST_PROXY=true on the API because the gateway is the only entry.
# Leave false if the API is reached directly.
TRUST_PROXY=false

LOG_LEVEL=INFO

# Uploaded statement bytes. Compose mounts this path on the API and the document worker.
# PDF passwords are not written here in plaintext.
FILE_STORAGE_DIR=/var/lib/spendpilot/files

# Used only by `docker compose --profile bootstrap run --rm bootstrap`.
# One-time. Refuses to run once any administrator exists. Omit until you are ready.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
